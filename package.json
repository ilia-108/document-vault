{
  "name": "document-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:ui": "vite --host 127.0.0.1 --port 3040 --strictPort",
    "mock:server": "node mock/server.cjs",
    "build": "yarn typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3040 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:mock:contract": "node --test mock/contract.test.cjs",
    "test:ui": "playwright test",
    "test:a11y": "playwright test tests/ui/accessibility.spec.ts"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.12.0",
    "@tanstack/react-virtual": "3.14.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-redux": "9.3.0",
    "react-router": "8.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "playwright-core": "1.61.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
