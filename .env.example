# Export these variables before running the local Go API.
EMAIL_MODE=log
EMAIL_FROM="Document Vault <login@your-verified-domain.example>"
# RESEND_API_KEY=
# SESSION_SECRET=
# DOCUMENT_ALLOWED_EMAILS=you@example.com
COOKIE_SECURE=false
DOCUMENT_LISTEN=127.0.0.1:3050
DOCUMENT_ALLOWED_ORIGIN=http://127.0.0.1:3040
DOCUMENT_DATA_DIR=.data/documents
BAO_ADDR=http://127.0.0.1:8200
BAO_TOKEN_FILE=.local/secrets/openbao-app-token
BAO_TRANSIT_MOUNT=transit
BAO_TRANSIT_KEY=document-vault
