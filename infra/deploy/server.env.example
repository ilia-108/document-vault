# Replace example values before starting the service. Never commit the real file.
DOCUMENT_LISTEN=127.0.0.1:3050
DOCUMENT_DATA_DIR=/var/lib/document-vault
DOCUMENT_ALLOWED_ORIGIN=https://docs.example.com
DOCUMENT_ALLOWED_EMAILS=you@example.com
EMAIL_MODE=resend
EMAIL_FROM="Document Vault <login@your-verified-domain.example>"
RESEND_API_KEY=
COOKIE_SECURE=true
BAO_ADDR=https://openbao.internal.example:8200
BAO_TOKEN_FILE=/etc/document-vault/openbao-token
BAO_TRANSIT_MOUNT=transit
BAO_TRANSIT_KEY=document-vault
# SESSION_SECRET is optional; if omitted, a random secret is persisted privately.
